<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hud="clr-namespace:NeoFastRider.UI;assembly=Assembly-CSharp"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      Background="Transparent"
      x:Name="VisorRoot">

    <!--
        NEO FAST RIDER · Helmet Visor HUD · NoesisGUI 3.x Compatible
        CAMBIOS vs v1:
          · Eliminado DropShadowEffect (no soportado en Noesis runtime)
          · Eliminado DrawingBrush / DrawingGroup / GeometryDrawing (no soportado)
          · Glow simulado con doble Path: grueso+transparente + fino+opaco
          · Barra de energía simplificada: Border + Rectangle gradient
          · Path.Data usa mini-language directamente (compatible Noesis)
    -->

    <Grid.Resources>

        <!-- ── BRUSHES NEÓN ── -->
        <SolidColorBrush x:Key="CyanBrush"       Color="#FF00FFFF"/>
        <SolidColorBrush x:Key="CyanGlowBrush"   Color="#5500FFFF"/>
        <SolidColorBrush x:Key="MagentaBrush"     Color="#FFFF1493"/>
        <SolidColorBrush x:Key="MagentaGlowBrush" Color="#55FF1493"/>
        <SolidColorBrush x:Key="RedBrush"         Color="#FFFF0055"/>
        <SolidColorBrush x:Key="CyanDimBrush"     Color="#8800FFFF"/>
        <SolidColorBrush x:Key="PanelBg"          Color="#14000018"/>

        <!-- ── CONVERTERS (compilados solo con #if NOESIS) ── -->
        <hud:RPMToArcGeometryConverter x:Key="RPMToArcGeometry"/>
        <hud:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ════════════════════════════════
             STYLE BASE: texto HUD
             ════════════════════════════════ -->
        <Style x:Key="HudLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
        </Style>
        <Style x:Key="HudMicro" TargetType="TextBlock" BasedOn="{StaticResource HudLabel}">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource CyanDimBrush}"/>
        </Style>

        <!-- ════════════════════════════════
             TEMPLATE: ProgressBar CoreEnergy
             Sin DrawingBrush — Border + gradient fill
             ════════════════════════════════ -->
        <ControlTemplate x:Key="EnergyBarTpl" TargetType="ProgressBar">
            <Grid Width="220" Height="16">
                <!-- Fondo oscuro -->
                <Rectangle Fill="#0F001020" RadiusX="2" RadiusY="2"/>
                <!-- Ticks de segmento simulados con bordes internos (sin DrawingBrush) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Divisores de segmento en columnas impares -->
                    <Rectangle Grid.Column="1"  Fill="#30000020"/>
                    <Rectangle Grid.Column="3"  Fill="#30000020"/>
                    <Rectangle Grid.Column="5"  Fill="#30000020"/>
                    <Rectangle Grid.Column="7"  Fill="#30000020"/>
                    <Rectangle Grid.Column="9"  Fill="#30000020"/>
                    <Rectangle Grid.Column="11" Fill="#30000020"/>
                    <Rectangle Grid.Column="13" Fill="#30000020"/>
                    <Rectangle Grid.Column="15" Fill="#30000020"/>
                    <Rectangle Grid.Column="17" Fill="#30000020"/>
                </Grid>
                <!-- Glow exterior (borde grueso semitransparente) -->
                <Border BorderBrush="{StaticResource CyanGlowBrush}" BorderThickness="2" CornerRadius="3"/>
                <!-- Borde interior preciso -->
                <Border BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="2"/>
                <!-- Fill de energía con gradiente horizontal -->
                <Rectangle x:Name="PART_Indicator"
                           HorizontalAlignment="Left"
                           RadiusX="2" RadiusY="2"
                           Margin="1">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF00FFFF" Offset="0.00"/>
                            <GradientStop Color="#CC00FFFF" Offset="0.45"/>
                            <GradientStop Color="#6600FFFF" Offset="0.80"/>
                            <GradientStop Color="#2200FFFF" Offset="1.00"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </ControlTemplate>

    </Grid.Resources>

    <!-- ════════════════════════════════════════════
         SHAKE TRANSFORM — HelmetVisorController lo anima
         ════════════════════════════════════════════ -->
    <Grid.RenderTransform>
        <TranslateTransform X="{Binding ShakeOffsetX}" Y="{Binding ShakeOffsetY}"/>
    </Grid.RenderTransform>

    <!-- ════════════════════════════════════════════
         LAYOUT: 3 filas
         ════════════════════════════════════════════ -->
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ══════════════════════════════════════════════════
         CAPA: MARCOS DEL VISOR (decoración táctica)
         Técnica fake-glow: Path grueso + transparente (halo)
                         + Path fino  + opaco    (línea real)
         ══════════════════════════════════════════════════ -->
    <Grid Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False">

        <!-- ESQUINA SUPERIOR IZQUIERDA — Cian -->
        <!-- Halo -->
        <Path HorizontalAlignment="Left" VerticalAlignment="Top" Width="130" Height="110"
              Data="M 2,108 L 2,28 Q 2,2 28,2 L 128,2 M 8,108 L 8,34 Q 8,8 34,8 L 90,8"
              Stroke="{StaticResource CyanGlowBrush}" StrokeThickness="6" Fill="Transparent"/>
        <!-- Línea real -->
        <Path HorizontalAlignment="Left" VerticalAlignment="Top" Width="130" Height="110"
              Data="M 2,108 L 2,28 Q 2,2 28,2 L 128,2 M 8,108 L 8,34 Q 8,8 34,8 L 90,8"
              Stroke="{StaticResource CyanBrush}" StrokeThickness="1.5" Fill="Transparent"/>
        <!-- Ticks calibración TL -->
        <Line HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,22,0,0"
              X1="0" Y1="0" X2="7" Y2="0" Stroke="{StaticResource CyanGlowBrush}" StrokeThickness="1"/>
        <Line HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,0,0,0"
              X1="0" Y1="0" X2="0" Y2="7" Stroke="{StaticResource CyanGlowBrush}" StrokeThickness="1"/>

        <!-- ESQUINA SUPERIOR DERECHA — Cian (espejada) -->
        <Path HorizontalAlignment="Right" VerticalAlignment="Top" Width="130" Height="110"
              Data="M 128,108 L 128,28 Q 128,2 102,2 L 2,2 M 122,108 L 122,34 Q 122,8 96,8 L 40,8"
              Stroke="{StaticResource CyanGlowBrush}" StrokeThickness="6" Fill="Transparent"/>
        <Path HorizontalAlignment="Right" VerticalAlignment="Top" Width="130" Height="110"
              Data="M 128,108 L 128,28 Q 128,2 102,2 L 2,2 M 122,108 L 122,34 Q 122,8 96,8 L 40,8"
              Stroke="{StaticResource CyanBrush}" StrokeThickness="1.5" Fill="Transparent"/>

        <!-- ESQUINA INFERIOR IZQUIERDA — Magenta -->
        <Path HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="130" Height="110"
              Data="M 2,2 L 2,82 Q 2,108 28,108 L 128,108 M 8,2 L 8,76 Q 8,102 34,102 L 90,102"
              Stroke="{StaticResource MagentaGlowBrush}" StrokeThickness="6" Fill="Transparent"/>
        <Path HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="130" Height="110"
              Data="M 2,2 L 2,82 Q 2,108 28,108 L 128,108 M 8,2 L 8,76 Q 8,102 34,102 L 90,102"
              Stroke="{StaticResource MagentaBrush}" StrokeThickness="1.5" Fill="Transparent"/>

        <!-- ESQUINA INFERIOR DERECHA — Magenta (espejada) -->
        <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="130" Height="110"
              Data="M 128,2 L 128,82 Q 128,108 102,108 L 2,108 M 122,2 L 122,76 Q 122,102 96,102 L 40,102"
              Stroke="{StaticResource MagentaGlowBrush}" StrokeThickness="6" Fill="Transparent"/>
        <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="130" Height="110"
              Data="M 128,2 L 128,82 Q 128,108 102,108 L 2,108 M 122,2 L 122,76 Q 122,102 96,102 L 40,102"
              Stroke="{StaticResource MagentaBrush}" StrokeThickness="1.5" Fill="Transparent"/>
    </Grid>

    <!-- ══════════════════════════════════════════════════
         FILA 0: CONTADOR DE TIEMPO — Centro superior
         ══════════════════════════════════════════════════ -->
    <Border Grid.Row="0"
            HorizontalAlignment="Center" Margin="0,18,0,0"
            Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource CyanGlowBrush}"
            BorderThickness="1" CornerRadius="3"
            Padding="20,6,20,8">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">

            <TextBlock Text="TIEMPO LÍMITE" Style="{StaticResource HudMicro}"
                       HorizontalAlignment="Center" Margin="0,0,0,2"/>

            <!-- Dígitos: parpadea rojo en estado crítico -->
            <TextBlock Text="{Binding TimeFormatted}"
                       FontFamily="Arial" FontSize="30" FontWeight="Bold"
                       HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource HudLabel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="TimerBlink">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <ColorAnimation
                                                Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                To="#FF0055" Duration="0:0:0.38"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="TimerBlink"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>

    <!-- ══════════════════════════════════════════════════
         FILA 2: HUD INFERIOR
         ══════════════════════════════════════════════════ -->
    <Grid Grid.Row="2" Margin="18,0,18,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════
             WIDGET: CORE ENERGY (izquierda)
             ════════════════════════════════ -->
        <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Bottom">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <!-- Icono hexagonal: doble path para fake glow -->
                <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                      Data="M 6,0 L 12,3 L 12,9 L 6,12 L 0,9 L 0,3 Z"
                      Fill="{StaticResource CyanGlowBrush}" Opacity="0.7"/>
                <Path Width="12" Height="12" Stretch="Uniform" Margin="-18,0,6,0"
                      Data="M 6,0 L 12,3 L 12,9 L 6,12 L 0,9 L 0,3 Z"
                      Fill="{StaticResource CyanBrush}"/>
                <TextBlock Text="CORE ENERGY" Style="{StaticResource HudMicro}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Barra segmentada enlazada a CoreEnergy [0..1] -->
            <ProgressBar Value="{Binding CoreEnergy}"
                         Minimum="0" Maximum="1"
                         Template="{StaticResource EnergyBarTpl}">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="EnergyPulse">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1.0" To="0.25" Duration="0:0:0.32"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="EnergyPulse"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <TextBlock Style="{StaticResource HudMicro}" Margin="0,4,0,0"
                       Text="{Binding CoreEnergyPercent, StringFormat={}{0:0}%}"/>
        </StackPanel>

        <!-- ════════════════════════════════
             WIDGET: VELOCÍMETRO + RPM ARC (derecha)
             ════════════════════════════════ -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">

            <!-- Tacómetro RPM — arc 110×110 -->
            <Canvas Width="110" Height="110" Margin="0,0,6,0">

                <!-- Arc background (halo) -->
                <Path Canvas.Left="0" Canvas.Top="0"
                      Data="M 13.4,79 A 48,48 0 1 1 96.6,79"
                      Stroke="#1800FFFF" StrokeThickness="8" Fill="Transparent"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <!-- Arc background real -->
                <Path Canvas.Left="0" Canvas.Top="0"
                      Data="M 13.4,79 A 48,48 0 1 1 96.6,79"
                      Stroke="#25FFFFFF" StrokeThickness="4" Fill="Transparent"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                <!-- Arc activo: StreamGeometry construida en el converter (halo) -->
                <Path Canvas.Left="0" Canvas.Top="0"
                      Data="{Binding RPMNormalized, Converter={StaticResource RPMToArcGeometry}}"
                      StrokeThickness="8" Fill="Transparent" Opacity="0.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Color="#00FFFF" Offset="0.0"/>
                            <GradientStop Color="#FF1493" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
                <!-- Arc activo: línea real -->
                <Path Canvas.Left="0" Canvas.Top="0"
                      Data="{Binding RPMNormalized, Converter={StaticResource RPMToArcGeometry}}"
                      StrokeThickness="3" Fill="Transparent"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Color="#00FFFF" Offset="0.0"/>
                            <GradientStop Color="#FF1493" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>

                <TextBlock Canvas.Left="36" Canvas.Top="68"
                           Text="RPM" Style="{StaticResource HudMicro}" FontSize="8"/>
            </Canvas>

            <!-- Dígitos velocidad -->
            <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <TextBlock Text="{Binding SpeedFormatted}"
                           FontFamily="Arial" FontSize="52" FontWeight="Bold" LineHeight="52">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HudLabel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="SpeedBlink">
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <ColorAnimation
                                                    Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                    To="#FF0055" Duration="0:0:0.38"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SpeedBlink"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="KM/H" FontFamily="Arial" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource CyanDimBrush}"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>

    <!-- ══════════════════════════════════════════════════
         OVERLAY: Viñeta roja crítica
         RadialGradient sin DropShadowEffect
         ══════════════════════════════════════════════════ -->
    <Border Grid.Row="0" Grid.RowSpan="3"
            IsHitTestVisible="False"
            Visibility="{Binding IsCritical, Converter={StaticResource BoolToVis}}">
        <Border.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                 RadiusX="0.75" RadiusY="0.75">
                <GradientStop Color="#00000000" Offset="0.4"/>
                <GradientStop Color="#50FF0055" Offset="1.0"/>
            </RadialGradientBrush>
        </Border.Background>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="Visibility" Value="Visible">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0.15" To="0.85" Duration="0:0:0.55"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>

</Grid>
